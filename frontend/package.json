{
  "name": "ai-employee-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "film": "node scripts/record-film.mjs --out ../docs/product-film.mp4",
    "demo": "node scripts/demo/server.mjs",
    "demo:record": "node scripts/record-demo.mjs ../docs/product-demo.mp4",
    "ad": "DEMO_AD=1 node scripts/record-demo.mjs /tmp/demo-ad.mp4 && python3 scripts/ad/make_ad.py /tmp/demo-ad.mp4 ../docs/product-ad.mp4 && cp ../docs/product-ad.mp4 public/media/product-ad.mp4"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "6.0.5"
  }
}
