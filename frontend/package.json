{
  "name": "baton-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "film": "node scripts/record-film.mjs --out ../docs/product-film.mp4",
    "demo:record": "node scripts/app-demo/record-app-demo.mjs /tmp/app-demo.mp4 && AD_SCRIPT=scripts/app-demo/script.json python3 scripts/ad/make_ad.py /tmp/app-demo.mp4 ../docs/product-demo.mp4",
    "ad:voice-setup": "npm install --no-save --no-package-lock --prefix scripts/ad/.voice n8n-nodes-ttsbro@0.1.6 sherpa-onnx-node"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "6.0.5"
  }
}
