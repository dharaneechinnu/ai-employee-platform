# Copy to .env and adjust. Never commit .env.

ENVIRONMENT=dev
DEBUG=true

# Lets your own AI server (Ollama, LM Studio) run on this machine
# (localhost, plain http). Development only: refused in prod.
ALLOW_PRIVATE_URLS=true

# Host ports are 5433/6380, not the defaults, so the containers do not
# clash with a PostgreSQL or Redis already installed on your machine.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/ai_employee
REDIS_URL=redis://localhost:6380/0

# One agent task makes 10-15 model calls, so concurrency is what trips a
# free-tier rate limit first. Keep this on while using free tiers.
SLOW_MODE=true
WORKER_MAX_JOBS=10

# Where people reach the app and API: used for OAuth redirects and the
# links in notification messages.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# One-click connections. Register an OAuth app with each provider and
# set its redirect URI to {PUBLIC_API_URL}/api/v1/oauth/{google|microsoft}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Web search for agents. Tavily is used if set, else Brave. Leave both empty to turn web_search off.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Outgoing email for notifications. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# Team mode as a supervisor graph (router, helpers side by side, review loop).
# Off until tried with a real model.
AGENT_SUPERVISOR=false

# Run chats as a LangGraph graph whose approval pauses are saved in Postgres.
# Runs already paused the old way still resume the old way.
AGENT_CHECKPOINTER=false
