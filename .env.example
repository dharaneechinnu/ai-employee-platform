# Copy to .env and adjust. Never commit .env.

ENVIRONMENT=dev
DEBUG=true

# Host ports are 5433/6380, not the defaults, so the containers do not
# clash with a PostgreSQL or Redis already installed on your machine.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/ai_employee
REDIS_URL=redis://localhost:6380/0

# One agent task makes 10-15 model calls, so concurrency is what trips a
# free-tier rate limit first. Keep this on while using free tiers.
SLOW_MODE=true
WORKER_MAX_JOBS=10
