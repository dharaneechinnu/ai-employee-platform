# Copy to .env and adjust. Never commit .env.

ENVIRONMENT=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/ai_employee
REDIS_URL=redis://localhost:6379/0

# One agent task makes 10-15 model calls, so concurrency is what trips a
# free-tier rate limit first. Keep this on while using free tiers.
SLOW_MODE=true
WORKER_MAX_JOBS=10
